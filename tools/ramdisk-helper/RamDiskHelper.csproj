<Project Sdk="Microsoft.NET.Sdk">

  <!-- The elevated ImDisk helper. Built on its own and its output deployed to
       <LaunchBox>\ThirdParty\RomExtractor\ramdisk\ - the folder LiteBox uses - so one helper
       serves both. It takes no command-line arguments: it reads ramdisk.cfg beside itself, which
       is what lets ONE fixed scheduled-task command cover both mount and unmount.

       NOT referenced by any plugin. src\Shared.RamDisk talks to it through the file system, never
       through a reference. -->

  <PropertyGroup>
    <!-- WinExe, not Exe: no console is allocated, so the elevated task runs without a cmd window
         flashing on screen. The helper has no console I/O at all - it reads ramdisk.cfg and writes
         ramdisk.result. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>

    <!-- SELF-CONTAINED, ONE FILE (Mehdi, 04/10: "que RamDiskHelper ne dépende pas de l'install de .NET 9"). Until 1.9.0 it
         was framework-dependent - four files and a .NET 9+ runtime on the machine, which LaunchBox 14 does not bring (it
         carries its own, in Core\) and the pack's setup did not install: on a clean PC the RAM disk never started. Now
         `dotnet publish` (build-release.ps1) makes ONE RamDiskHelper.exe carrying its runtime, compressed. Not trimmed:
         the helper loads its embedded libraries (ZstdSharp, CHDSharp...) by reflection. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>RamDiskHelper</AssemblyName>
    <RootNamespace>RamDiskHelper</RootNamespace>
    <!-- THE NUMBER BOTH PRODUCTS COMPARE. 1.0 is the protocol as it shipped; 1.1 added image,
         type, sparse and format to ramdisk.cfg. Both sides deploy this helper when the one on
         disk is ABSENT OR OLDER and never when it is newer, and a caller checks this version
         before sending a key the older one would silently ignore. Bump it with the protocol,
         never with an ordinary fix. 1.9.1 is the one exception: the protocol of 1.9.0, self-contained - numbered
         above it so that "absent or older" replaces the framework-dependent 1.9.0 already deployed. -->
    <Version>1.10.0</Version>

    <Platforms>AnyCPU;x64</Platforms>
    <UseWindowsForms>false</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- 1.7: an Xbox disc's FAT32 view (view=xbox) - the Cxbx plugin's reader and view, the same files. -->
  <ItemGroup>
    <Compile Include="..\..\src\Cxbx\Xdvdfs.cs" Link="Xbox\Xdvdfs.cs" />
    <Compile Include="..\..\src\Cxbx\XisoFatView.cs" Link="Xbox\XisoFatView.cs" />
    <!-- 1.10: the disc's XISO as the one file of an exFAT volume (view=xiso), for xemu. -->
    <Compile Include="..\..\src\Xemu\ExfatOneFileView.cs" Link="Xbox\ExfatOneFileView.cs" />
  </ItemGroup>

  <!-- 1.8: a ZArchive (.zar) served as the disc it holds (view=xbox) - the pack's one reader. Its zstd, ZstdSharp, is EMBEDDED and
       loaded on demand (Program.Main): no file more to deploy beside the helper, and none in the deps manifest, where a
       missing one would stop the host before Main. -->
  <ItemGroup>
    <Compile Include="..\..\src\Shared.Zar\**\*.cs" LinkBase="Zar" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" GeneratePathProperty="true" ExcludeAssets="runtime" PrivateAssets="all" />
    <EmbeddedResource Include="$(PkgZstdSharp_Port)\lib\net9.0\ZstdSharp.dll" LogicalName="ZstdSharp.dll" Visible="false" />
  </ItemGroup>

  <!-- 1.9: a CSO, a CCI or a CHD served as the disc it holds (view=xbox) - src\Shared.Disc. CHDSharp and what it needs are EMBEDDED
       like ZstdSharp, its LGPL FLAC too, as the PPSSPP and Flycast plugins merge it (THIRD-PARTY.md): still no file more beside the
       helper, the four HelperFiles. -->
  <ItemGroup>
    <Compile Include="..\..\src\Shared.Disc\**\*.cs" LinkBase="Disc" />
    <PackageReference Include="CHDSharp" Version="1.4.3" GeneratePathProperty="true" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" GeneratePathProperty="true" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.11" GeneratePathProperty="true" ExcludeAssets="runtime" PrivateAssets="all" />
    <EmbeddedResource Include="$(PkgCHDSharp)\lib\net9.0\CHDSharpLib.dll" LogicalName="CHDSharpLib.dll" Visible="false" />
    <EmbeddedResource Include="$(PkgCHDSharp)\lib\net9.0\VendoredLZMA.dll" LogicalName="VendoredLZMA.dll" Visible="false" />
    <EmbeddedResource Include="$(PkgCHDSharp)\lib\net9.0\VendoredZLib.dll" LogicalName="VendoredZLib.dll" Visible="false" />
    <EmbeddedResource Include="$(PkgCHDSharp)\lib\net9.0\VendoredZSTD.dll" LogicalName="VendoredZSTD.dll" Visible="false" />
    <EmbeddedResource Include="$(PkgMicrosoft_Extensions_Logging_Abstractions)\lib\net9.0\Microsoft.Extensions.Logging.Abstractions.dll" LogicalName="Microsoft.Extensions.Logging.Abstractions.dll" Visible="false" />
    <EmbeddedResource Include="$(PkgSystem_IO_Hashing)\lib\net9.0\System.IO.Hashing.dll" LogicalName="System.IO.Hashing.dll" Visible="false" />
    <EmbeddedResource Include="$(PkgCHDSharp)\lib\net9.0\VendoredFlac.dll" LogicalName="VendoredFlac.dll" Visible="false" />
  </ItemGroup>

</Project>
