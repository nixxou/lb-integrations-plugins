<Project Sdk="Microsoft.NET.Sdk">

  <!-- A copy of Xenia.csproj: the same references for the same reasons - see the notes there. -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- WPF: Shared.Lbip watches LaunchBox's import wizard. WinForms: LbipNotice, the progress window. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Cxbx</AssemblyName>
    <RootNamespace>LbIntegrations.Cxbx</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <!-- The catalogue contract, shipped beside the plugin rather than merged - see Xenia.csproj. -->
    <ProjectReference Include="..\Catalog\Catalog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared.Lbip\**\*.cs" />
    <!-- The look of the Nixx windows, LiteBox's: the theme and the shell of a game's window. -->
    <Compile Include="..\Shared.Ui\**\*.cs" />
    <!-- The pack's console identity ("Your console") - see src\Shared.Identity\PackIdentity.cs. -->
    <Compile Include="..\Shared.Identity\**\*.cs" />
    <Compile Include="..\Shared.Menu\**\*.cs" />
    <!-- The RAM disk a game is unpacked to - the one LiteBox, melonDS, Vita3K and Xenia mount. -->
    <Compile Include="..\Shared.RamDisk\**\*.cs" />
    <!-- ZArchive (.zar) - the pack's one reader. -->
    <Compile Include="..\Shared.Zar\**\*.cs" />
    <!-- CSO, CCI, CHD (03/10) - the disc's bytes through its container. -->
    <Compile Include="..\Shared.Disc\**\*.cs" />
    <Compile Include="..\Shared.Xbox\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="SharpCompress" Version="0.41.0" />
    <!-- zstd for ZArchive - the version SharpCompress already brings. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
    <!-- CHD - the library the PPSSPP and Flycast plugins merge, its LGPL FLAC included: see THIRD-PARTY.md, "LGPL-2.1 and how it is satisfied". -->
    <PackageReference Include="CHDSharp" Version="1.4.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Unbroken.LaunchBox.Plugins">
      <HintPath>..\..\vendor\Unbroken.LaunchBox.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Every dependency folded INTO Cxbx.dll, internalized - see Xenia.csproj. -->
  <Target Name="MergePlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <MergedDir>$(OutDir)merged\</MergedDir>
    </PropertyGroup>
    <ItemGroup>
      <MergeInput Include="$(OutDir)$(AssemblyName).dll" />
      <MergeInput Include="$(OutDir)*.dll" Exclude="$(OutDir)$(AssemblyName).dll;$(OutDir)LbIntegrations.Catalog.dll" />
      <MergeLib Include="@(ReferencePath->'%(RootDir)%(Directory).')" />
    </ItemGroup>
    <MakeDir Directories="$(MergedDir)" />
    <Exec Command="dotnet ilrepack /out:&quot;$(MergedDir)$(AssemblyName).dll&quot; /internalize @(MergeLib->Distinct()->'/lib:&quot;%(Identity)&quot;', ' ') @(MergeInput->'&quot;%(FullPath)&quot;', ' ')"
          WorkingDirectory="$(MSBuildProjectDirectory)" StandardOutputImportance="low" />
    <Message Importance="high" Text="  merged -> $(MergedDir)$(AssemblyName).dll" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\help\cxbx.html" LogicalName="help.html" />
    <!-- The site's compatibility list as it was when the plugin was built (the probe's cxbx-compat-snapshot arm): a game has an
         answer offline and before any refresh. See CxbxCompat.cs. -->
    <EmbeddedResource Include="compat.json" LogicalName="compat.json" />
  </ItemGroup>

</Project>
