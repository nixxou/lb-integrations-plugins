<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- net9 and not net10: a net9 assembly loads on the .NET 9 runtime (LaunchBox 13.27)
         AND on .NET 10 (13.28+, 14), so one build covers every host. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MelonDs</AssemblyName>
    <RootNamespace>LbIntegrations.MelonDs</RootNamespace>

    <!-- WinForms, for ONE window: the one that says a NAND is missing and offers to open the folder
         it belongs in. The LaunchBox SDK has no message API of any kind - the whole vendored
         assembly holds no ShowMessage, no dialog, nothing - so a plugin that wants to say something
         at launch time has to bring its own. The assemblies come from the shared framework and are
         not copy-local, so the ILRepack step below does not see them; that was verified, not
         assumed. See MelonDsMissingFiles. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- true so SharpCompress and Harmony land in bin\ for the merge step below. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- MSB3277: the vendored 13.27 SDK and a host's newer one differ in version; that is the
         point of Private=false, so the warning is noise. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <!-- THE SHARED DSi ENGINE, compiled in rather than referenced. Two plugins drive a DSi NAND -
         melonDS and no$gba - and the machinery between a user's dump and a save is the same for
         both: it talks to the image, not to the emulator. This repository copies its shared pieces
         instead of linking them, which is right for Log.cs (three lines of difference between
         copies) and wrong for four thousand lines that took three measured defects to get right.
         Compiling the folder in keeps the deployment contract untouched: ILRepack still folds
         everything into one MelonDs.dll. See src\Shared.Dsi\DsiLog.cs for how it reaches this
         plugin's logger without naming it. -->
    <Compile Include="..\Shared.Dsi\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- THE CATALOGUE CONTRACT, referenced and SHIPPED rather than merged. It is the one assembly
         of this pack that a host also holds, and type identity in .NET is per-assembly: merged and
         internalized it would become a private type of this DLL, and the host's `is
         ILbCatalogSource` would answer no. So it stays its own file beside the plugin - the one
         exception to "a plugin folder holds exactly one managed file", and it buys the difference
         between being asked and patching somebody's database reads. See src\Catalog\LbCatalog.cs. -->
    <ProjectReference Include="..\Catalog\Catalog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- THE SHARED ROW INJECTION, compiled in rather than referenced. All five plugins publish
         rows into LaunchBox's emulator catalogue, and the machinery is identical for every one of
         them: it talks to the host's SQLite reads, not to any one emulator. It was three verbatim
         copies before this - Flycast's and no$gba's differed by a single `using` line over eight
         hundred - and copies is exactly what this must not be: LbipRows.SharedKey and
         LbipRowInjection.OwnerKey are the only things two plugins in one process can find each
         other by, so a drift of one character silently costs an emulator its row. One source
         folder is how they cannot drift. ILRepack still folds it into one DLL per plugin. See
         src\Shared.Lbip\LbipLog.cs for how it reaches this plugin's logger without naming it. -->
    <Compile Include="..\Shared.Lbip\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the SDK but DON'T copy it: the host loads the plugin into ITS assembly load
         context and provides the SDK, so the types unify. Shipping our own copy beside the DLL
         would give us a second, incompatible set of EmulatorPlugin/IEmulator types and the host
         would never recognise the plugin. See vendor\README.md. -->
    <Reference Include="Unbroken.LaunchBox.Plugins">
      <HintPath>..\..\vendor\Unbroken.LaunchBox.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The DSiWare metadata index, carried inside the assembly: about 1700 titles in 0.6 MB, one
       file rather than seventeen hundred beside the plugin, which is the ordinary way any program
       carries its data. Its layout is written out at the top of tools\pack-tmd-library.ps1, which
       is also what builds it - a sorted table read in place, then deflated blocks of sixteen entries
       of which a lookup inflates exactly one. LogicalName drops the namespace so the resource is
       asked for by the name it has on disk. -->
  <ItemGroup>
    <EmbeddedResource Include="tmd-library.bin" LogicalName="tmd-library.bin"
                      Condition="Exists('tmd-library.bin')" />
  </ItemGroup>

  <ItemGroup>
    <!-- SharpCompress reads a game's .zip, .7z or .rar, which is where the save's name comes from
         when melonDS loads a ROM out of an archive - see Archives.cs. -->
    <PackageReference Include="SharpCompress" Version="0.41.0" />
    <!-- 2.4.2 matches what ExtendDB ships, so HarmonySharedState - found by module name across
         assemblies - is shared rather than duplicated. See LbipRowInjection.cs. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>

  <!-- The native NAND library travels with the build output, so the probe and the deploy script
       both find it beside the plugin the way the host will. It is NOT merged and could not be: it
       is native code, and the licence boundary is the point (see THIRD-PARTY.md). Absent is a
       normal state - the plugin says so and carries on - so this copies only when it is there. -->
  <Target Name="CopyNandLibrary" AfterTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)\..\..\build\nand\melonds-nand.dll')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\build\nand\melonds-nand.dll"
          DestinationFiles="$(OutDir)merged\native\melonds-nand.native"
          SkipUnchangedFiles="true" Condition="'$(Configuration)' == 'Release'" />
  </Target>

  <!-- Fold every dependency INTO MelonDs.dll, internalized.
       Two reasons, both measured. A plugin folder is a shared namespace: the host resolves a
       dependency by simple name across every plugin's folder, so two plugins shipping different
       versions of the same library is a real hazard. After this step the assembly's reference table
       holds exactly one non-framework entry, Unbroken.LaunchBox.Plugins - there is nothing left to
       collide. And the plugin stays one file, which is what makes it obvious what to copy.
       The SDK is NOT merged: Private=false keeps it out of bin\, and the host must provide it so
       the interface types unify. -->
  <Target Name="MergePlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <MergedDir>$(OutDir)merged\</MergedDir>
    </PropertyGroup>
    <ItemGroup>
      <MergeInput Include="$(OutDir)$(AssemblyName).dll" />
      <!-- melonds-nand.dll is NATIVE: ILRepack refuses it, and rightly - it is a separate
           file loaded through P/Invoke, not an assembly to fold in. Named here because a
           glob that grows is how a build breaks for a reason nobody expects. -->
      <MergeInput Include="$(OutDir)*.dll"
                  Exclude="$(OutDir)$(AssemblyName).dll;$(OutDir)melonds-nand.dll;$(OutDir)LbIntegrations.Catalog.dll" />
      <!-- The trailing "." keeps a directory ending in \ from escaping the closing quote. -->
      <MergeLib Include="@(ReferencePath->'%(RootDir)%(Directory).')" />
    </ItemGroup>
    <MakeDir Directories="$(MergedDir)" />
    <Exec Command="dotnet ilrepack /out:&quot;$(MergedDir)$(AssemblyName).dll&quot; /internalize @(MergeLib->Distinct()->'/lib:&quot;%(Identity)&quot;', ' ') @(MergeInput->'&quot;%(FullPath)&quot;', ' ')"
          WorkingDirectory="$(MSBuildProjectDirectory)" StandardOutputImportance="low" />
    <Message Importance="high" Text="  merged -> $(MergedDir)$(AssemblyName).dll" />
  </Target>

</Project>
