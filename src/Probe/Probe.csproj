<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Probe</AssemblyName>
    <RootNamespace>LbIntegrations.Probe</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>

    <!-- The probe HOSTS the plugin, so it has to offer what the plugin needs. MelonDs shows one
         window and therefore asks for WinForms; without this the probe's process cannot resolve
         System.Windows.Forms and the plugin fails inside it in a way no real host would. That is
         not a fidelity this harness can do without - it is also the canary for a host that really
         does lack it. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- IGame has a member typed from System.Drawing, and DispatchProxy materialises EVERY method of
         an interface before it can build a proxy - so StubGame cannot be created without this.
         The plugin itself never touches it. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <!-- The row injection runs inside somebody else's query, so it is confronted with a real
         provider rather than asserted about. Here a PackageReference is exactly right and in the
         plugin it would be exactly wrong: the probe is the host, and the plugin must patch whatever
         copy its host already loaded. The version matches what LaunchBox 14 ships. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- THE CONTRACT, held the way a host holds it. This is not a convenience: the whole claim
         being tested is that the interface a plugin implements and the one a host names are the
         SAME TYPE. Referencing it here puts one copy in the default load context before any plugin
         is loaded, which is exactly what LiteBox does, and lets the check below assert identity
         rather than a matching name. -->
    <ProjectReference Include="..\Catalog\Catalog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The probe DOES need the SDK beside it: it is the host here, so it must provide the types
         the plugin resolves against. This is the one project where Private=true is correct. -->
    <Reference Include="Unbroken.LaunchBox.Plugins">
      <HintPath>..\..\vendor\Unbroken.LaunchBox.Plugins.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
