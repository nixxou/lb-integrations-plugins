<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- net9 and not net10: a net9 assembly loads on the .NET 9 runtime (LaunchBox 13.27)
         AND on .NET 10 (13.28+, 14), so one build covers every host. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Demul</AssemblyName>
    <RootNamespace>LbIntegrations.Demul</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- true so the dependencies land in bin\ for the merge step below. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- MSB3277: the vendored 13.27 SDK and a host's newer one differ in version; that is the
         point of Private=false, so the warning is noise. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <!-- Shared.Lbip and Shared.Menu use WinForms (the notice a refused launch shows, the menu icon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- And WPF: LaunchBox's Import ROM Files wizard is WPF, watched from its windows - see Shared.Lbip\LbipImportWatch.cs. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- THE CATALOGUE CONTRACT, referenced and SHIPPED rather than merged - see
         src\Catalog\LbCatalog.cs and the same note in Xenia.csproj. -->
    <ProjectReference Include="..\Catalog\Catalog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- THE SHARED ROW INJECTION, compiled in rather than referenced - see src\Shared.Lbip. -->
    <Compile Include="..\Shared.Lbip\**\*.cs" />
    <!-- And the menu helpers: the right-click entry's icon (LbipMenuIcon). -->
    <Compile Include="..\Shared.Menu\**\*.cs" />
    <!-- The look of the Nixx windows, LiteBox's: the theme and the shell of a game's window. -->
    <Compile Include="..\Shared.Ui\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- LaunchBox's metadata has a Demul row for the Dreamcast alone, so this pack publishes its
         own - see src\Shared.Lbip. Same version as the other plugins, so
         HarmonySharedState is shared and they coordinate. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the SDK but DON'T copy it: the host loads the plugin into ITS assembly load
         context and provides the SDK, so the types unify. See vendor\README.md. -->
    <Reference Include="Unbroken.LaunchBox.Plugins">
      <HintPath>..\..\vendor\Unbroken.LaunchBox.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Demul ships as a solid .7z, which System.IO.Compression cannot read. Same version as the
         Xenia and Cxbx plugins. -->
    <PackageReference Include="SharpCompress" Version="0.41.0" />
  </ItemGroup>

  <!-- Fold every dependency INTO Demul.dll, internalized. See Xenia.csproj for why. -->
  <Target Name="MergePlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <MergedDir>$(OutDir)merged\</MergedDir>
    </PropertyGroup>
    <ItemGroup>
      <MergeInput Include="$(OutDir)$(AssemblyName).dll" />
      <MergeInput Include="$(OutDir)*.dll" Exclude="$(OutDir)$(AssemblyName).dll;$(OutDir)LbIntegrations.Catalog.dll" />
      <!-- The trailing "." keeps a directory ending in \ from escaping the closing quote. -->
      <MergeLib Include="@(ReferencePath->'%(RootDir)%(Directory).')" />
    </ItemGroup>
    <MakeDir Directories="$(MergedDir)" />
    <Exec Command="dotnet ilrepack /out:&quot;$(MergedDir)$(AssemblyName).dll&quot; /internalize @(MergeLib->Distinct()->'/lib:&quot;%(Identity)&quot;', ' ') @(MergeInput->'&quot;%(FullPath)&quot;', ' ')"
          WorkingDirectory="$(MSBuildProjectDirectory)" StandardOutputImportance="low" />
    <Message Importance="high" Text="  merged -> $(MergedDir)$(AssemblyName).dll" />
  </Target>

  <ItemGroup>
    <!-- The plugin's user guide, shown from the General tab of the Nixx window (src\Menus\Settings.cs): embedded, so it
         travels inside the DLL and no deployment list has to know about it. -->
    <EmbeddedResource Include="..\..\docs\help\demul.html" LogicalName="help.html" />
    <!-- Every MAME romset of Demul's boards - generated by tools\demul-sets\make-sets.py, read by DemulSets.cs. -->
    <EmbeddedResource Include="demul-sets.tsv" LogicalName="demul-sets.tsv" />
  </ItemGroup>

</Project>
