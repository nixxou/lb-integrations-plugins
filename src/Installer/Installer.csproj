<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net9 here for the same reason the plugins use it, plus one of its own: this exe ships its
         own runtime, so the only thing the target machine has to have is Windows. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>NixxIntegrations</AssemblyName>
    <RootNamespace>NixxIntegrations</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- The pack's version, shown in the window's header - the same as the plugins' manifests (InstalledVersion). -->
    <Version>1.1.0</Version>
    <!-- Drawn by tools\installer-icon. The window takes it from the exe (Icon.ExtractAssociatedIcon). -->
    <ApplicationIcon>nixx.ico</ApplicationIcon>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- One file, no prerequisite. It is about 60 MB of which roughly 50 is the .NET runtime, and
         that is the trade being made on purpose: a download that works on a machine with no .NET
         installed, against a smaller one that fails with an obscure dialog when it is missing. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>


  <ItemGroup>
    <!-- THE RAM DISK, compiled in rather than referenced - and pointed at LiteBox's machinery
         rather than standing up its own. LiteBox already ships an ImDisk mount driven by ONE
         elevated scheduled task; a second set of the same parts beside it would be two tasks, two
         helpers and two things for a user to understand. These sources speak its protocol exactly,
         write to the same folder and look for the same task. See src\Shared.RamDisk\RamDisk.cs for
         the protocol, and RamDiskLog.cs for how it reaches a log without naming one. -->
    <Compile Include="..\Shared.RamDisk\**\*.cs" />
    <!-- "Your console": the pack's one identity and the panel that edits it - the Nixx window's tab, the same file. -->
    <Compile Include="..\Shared.Identity\**\*.cs" />
    <Compile Include="..\Menus\IdentityPanel.cs" Link="Identity\IdentityPanel.cs" />
  </ItemGroup>

  <!-- THE PAYLOAD, staged by build-release.ps1 and handed over as a property.
       The project does NOT reach into the plugins' bin\ folders itself: the release script builds
       them, copies the merged DLL, the manifest and the native library into one directory, and
       passes that directory here. One place decides what a release contains.

       LogicalName is the name Payload.cs asks for, and it is the plugin folder's own name in
       every case - no$gba's row lost its dollar, so there is nothing left to map.

       Declared STATICALLY rather than globbed or appended from a target. Resource names are
       assigned early in the build, before a target has had a chance to add anything, and an item
       added later is ignored IN SILENCE - which is the worst way to ship an installer with no
       payload in it. A literal Include needs no file at evaluation time, only by the time the
       compiler runs, which the check below enforces. -->
  <ItemGroup Condition="'$(PayloadDir)' != ''">
    <EmbeddedResource Include="$(PayloadDir)\Nixx-Flycast\Flycast.dll">
      <LogicalName>payload/Nixx-Flycast/Flycast.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PayloadDir)\Nixx-Flycast\manifest.json">
      <LogicalName>payload/Nixx-Flycast/manifest.json</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="$(PayloadDir)\Nixx-melonDS\MelonDs.dll">
      <LogicalName>payload/Nixx-melonDS/MelonDs.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PayloadDir)\Nixx-melonDS\manifest.json">
      <LogicalName>payload/Nixx-melonDS/manifest.json</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="$(PayloadDir)\Nixx-nogba\NoGba.dll">
      <LogicalName>payload/Nixx-nogba/NoGba.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PayloadDir)\Nixx-nogba\manifest.json">
      <LogicalName>payload/Nixx-nogba/manifest.json</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="$(PayloadDir)\Nixx-PPSSPP\Ppsspp.dll">
      <LogicalName>payload/Nixx-PPSSPP/Ppsspp.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PayloadDir)\Nixx-PPSSPP\manifest.json">
      <LogicalName>payload/Nixx-PPSSPP/manifest.json</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="$(PayloadDir)\Nixx-SuperZSNES\SuperZsnes.dll">
      <LogicalName>payload/Nixx-SuperZSNES/SuperZsnes.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PayloadDir)\Nixx-SuperZSNES\manifest.json">
      <LogicalName>payload/Nixx-SuperZSNES/manifest.json</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="$(PayloadDir)\Nixx-Vita3K\Vita3k.dll">
      <LogicalName>payload/Nixx-Vita3K/Vita3k.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PayloadDir)\Nixx-Vita3K\manifest.json">
      <LogicalName>payload/Nixx-Vita3K/manifest.json</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="$(PayloadDir)\Nixx-Cxbx\Cxbx.dll">
      <LogicalName>payload/Nixx-Cxbx/Cxbx.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PayloadDir)\Nixx-Cxbx\manifest.json">
      <LogicalName>payload/Nixx-Cxbx/manifest.json</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="$(PayloadDir)\Nixx-Xenia\Xenia.dll">
      <LogicalName>payload/Nixx-Xenia/Xenia.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PayloadDir)\Nixx-Xenia\manifest.json">
      <LogicalName>payload/Nixx-Xenia/manifest.json</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="$(PayloadDir)\Nixx-Menus\NixxMenus.dll">
      <LogicalName>payload/Nixx-Menus/NixxMenus.dll</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="$(PayloadDir)\LbIntegrations.Catalog.dll">
      <LogicalName>payload/LbIntegrations.Catalog.dll</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="$(PayloadDir)\ramdisk\RamDiskHelper.exe">
      <LogicalName>payload/ramdisk/RamDiskHelper.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PayloadDir)\ramdisk\RamDiskHelper.dll">
      <LogicalName>payload/ramdisk/RamDiskHelper.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PayloadDir)\ramdisk\RamDiskHelper.deps.json">
      <LogicalName>payload/ramdisk/RamDiskHelper.deps.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PayloadDir)\ramdisk\RamDiskHelper.runtimeconfig.json">
      <LogicalName>payload/ramdisk/RamDiskHelper.runtimeconfig.json</LogicalName>
    </EmbeddedResource>

    <EmbeddedResource Include="$(PayloadDir)\native\melonds-nand.dll">
      <LogicalName>payload/native/melonds-nand.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PayloadDir)\native\melonds-nandtool.exe">
      <LogicalName>payload/native/melonds-nandtool.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PayloadDir)\native\vita3k-install.dll">
      <LogicalName>payload/native/vita3k-install.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PayloadDir)\native\flycast-id.exe">
      <LogicalName>payload/native/flycast-id.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- THE IMDISK DRIVER, as LTR Data's own package installs it - see vendor\imdisk\SOURCE.md and
       ImDiskSetup.cs. In the repository rather than staged: it is not built, it is taken as shipped.
       The resource names keep the INF's source layout, which is what the INF looks for. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\vendor\imdisk\imdisk.inf"><LogicalName>payload/imdisk/imdisk.inf</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\vendor\imdisk\uninstall_imdisk.cmd"><LogicalName>payload/imdisk/uninstall_imdisk.cmd</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\vendor\imdisk\sys\amd64\imdisk.sys"><LogicalName>payload/imdisk/sys/amd64/imdisk.sys</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\vendor\imdisk\cli\amd64\imdisk.exe"><LogicalName>payload/imdisk/cli/amd64/imdisk.exe</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\vendor\imdisk\cli\i386\imdisk.exe"><LogicalName>payload/imdisk/cli/i386/imdisk.exe</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\vendor\imdisk\cpl\amd64\imdisk.cpl"><LogicalName>payload/imdisk/cpl/amd64/imdisk.cpl</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\vendor\imdisk\cpl\i386\imdisk.cpl"><LogicalName>payload/imdisk/cpl/i386/imdisk.cpl</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\vendor\imdisk\svc\amd64\imdsksvc.exe"><LogicalName>payload/imdisk/svc/amd64/imdsksvc.exe</LogicalName></EmbeddedResource>
  </ItemGroup>

  <!-- THE AIM TOOLKIT, offered beside ImDisk: its files.cab as shipped - vendor\aim\SOURCE.md and AimSetup.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\vendor\aim\files.cab"><LogicalName>payload/aim/files.cab</LogicalName></EmbeddedResource>
  </ItemGroup>

  <!-- FAIL LOUDLY RATHER THAN SHIP AN EMPTY INSTALLER. An exe with no payload builds perfectly
       well and then tells the user "Embedded payload missing" the first time they press a button,
       which is a defect discovered by the wrong person. -->
  <Target Name="CheckPayload" BeforeTargets="CoreCompile">
    <Error Condition="'$(PayloadDir)' == ''"
           Text="No PayloadDir. Build this through build-release.ps1, which builds every plugin and stages their files first." />
    <Error Condition="'%(EmbeddedResource.Identity)' != '' and !Exists('%(EmbeddedResource.Identity)')"
           Text="Payload file missing: %(EmbeddedResource.Identity)" />
  </Target>

</Project>
