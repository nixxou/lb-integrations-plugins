<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- net9 and not net10: a net9 assembly loads on the .NET 9 runtime (LaunchBox 13.27)
         AND on .NET 10 (13.28+, 14), so one build covers every host. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Xenia</AssemblyName>
    <RootNamespace>LbIntegrations.Xenia</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- true so the CHD libraries land in bin\ for the merge step below. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- MSB3277: the vendored 13.27 SDK and a host's newer one differ in version; that is the
         point of Private=false, so the warning is noise. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <!-- THE CATALOGUE CONTRACT, referenced and SHIPPED rather than merged. It is the one assembly
         of this pack that a host also holds, and type identity in .NET is per-assembly: merged and
         internalized it would become a private type of this DLL, and the host's `is
         ILbCatalogSource` would answer no. So it stays its own file beside the plugin - the one
         exception to "a plugin folder holds exactly one managed file", and it buys the difference
         between being asked and patching somebody's database reads. See src\Catalog\LbCatalog.cs. -->
    <ProjectReference Include="..\Catalog\Catalog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- THE SHARED ROW INJECTION, compiled in rather than referenced. All five plugins publish
         rows into LaunchBox's emulator catalogue, and the machinery is identical for every one of
         them: it talks to the host's SQLite reads, not to any one emulator. It was three verbatim
         copies before this - Flycast's and no$gba's differed by a single `using` line over eight
         hundred - and copies is exactly what this must not be: LbipRows.SharedKey and
         LbipRowInjection.OwnerKey are the only things two plugins in one process can find each
         other by, so a drift of one character silently costs an emulator its row. One source
         folder is how they cannot drift. ILRepack still folds it into one DLL per plugin. See
         src\Shared.Lbip\LbipLog.cs for how it reaches this plugin's logger without naming it. -->
    <Compile Include="..\Shared.Lbip\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- LaunchBox's metadata already has a row for this emulator, but not one that says a plugin
         drives it, so this pack publishes its own beside it - see src\Shared.Lbip. That injection
         is a Harmony patch on the host's SQLite reads. Harmony merges and internalizes cleanly
         HERE - measured: it fails only when the merged assembly is a process ENTRY POINT, because
         its module initializer then runs before System.Runtime resolves. Loaded as a plugin into a
         running host, which is our case, it patches normally.
         Version 2.4.2 matches what ExtendDB ships, so HarmonySharedState (found by module name
         across assemblies) is shared and the two coordinate. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the SDK but DON'T copy it: the host loads the plugin into ITS assembly load
         context and provides the SDK, so the types unify. Shipping our own copy beside the DLL
         would give us a second, incompatible set of EmulatorPlugin/IEmulator types and the host
         would never recognise the plugin. See vendor\README.md. -->
    <Reference Include="Unbroken.LaunchBox.Plugins">
      <HintPath>..\..\vendor\Unbroken.LaunchBox.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.41.0" />
  </ItemGroup>

  <!-- Fold every dependency INTO Ppsspp.dll, internalized.
       Two reasons, both measured. A plugin folder is a shared namespace: the host resolves a
       dependency by simple name across every plugin's folder, so two plugins shipping different
       versions of the same library is a real hazard. After this step the assembly's reference table
       holds exactly one non-framework entry, Unbroken.LaunchBox.Plugins - there is nothing left to
       collide. And the plugin stays one file, which is what makes it obvious what to copy.
       The SDK is NOT merged: Private=false keeps it out of bin\, and the host must provide it so
       the interface types unify. -->
  <Target Name="MergePlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <MergedDir>$(OutDir)merged\</MergedDir>
    </PropertyGroup>
    <ItemGroup>
      <MergeInput Include="$(OutDir)$(AssemblyName).dll" />
      <MergeInput Include="$(OutDir)*.dll" Exclude="$(OutDir)$(AssemblyName).dll;$(OutDir)LbIntegrations.Catalog.dll" />
      <!-- The trailing "." keeps a directory ending in \ from escaping the closing quote. -->
      <MergeLib Include="@(ReferencePath->'%(RootDir)%(Directory).')" />
    </ItemGroup>
    <MakeDir Directories="$(MergedDir)" />
    <Exec Command="dotnet ilrepack /out:&quot;$(MergedDir)$(AssemblyName).dll&quot; /internalize @(MergeLib->Distinct()->'/lib:&quot;%(Identity)&quot;', ' ') @(MergeInput->'&quot;%(FullPath)&quot;', ' ')"
          WorkingDirectory="$(MSBuildProjectDirectory)" StandardOutputImportance="low" />
    <Message Importance="high" Text="  merged -> $(MergedDir)$(AssemblyName).dll" />
  </Target>

</Project>
